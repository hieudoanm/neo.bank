# NEO Bank — local development environment.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored. Multi-line values (PEM keys) are double-quoted with
# literal \n escape sequences, which Docker Compose expands into newlines.
#
# Generate a development RSA key pair (do not use these for anything real):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   # then paste each file's contents below, replacing newlines with \n
#   awk 'BEGIN{ORS="\\n"}{print}' private.pem
#   awk 'BEGIN{ORS="\\n"}{print}' public.pem

APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JWT_KEY_ID=dev-key-1
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"

# API Gateway rate limiting (see docs/06-api-specification.md §8).
RATE_LIMIT_AUTH_PER_MIN=100
RATE_LIMIT_USER_PER_MIN=1000
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
